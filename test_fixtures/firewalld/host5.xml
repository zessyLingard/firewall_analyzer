<?xml version="1.0" encoding="utf-8"?>
<zone target="default">
  <short>Public</short>
  <description>For use in public areas. You do not trust the other computers on networks to not harm your computer. Only selected incoming connections are accepted.</short>
  <service name="ssh"/>
  <service name="http"/>
  <service name="https"/>
  <service name="dns"/>
  <service name="ntp"/>
  <port protocol="tcp" port="22"/>
  <port protocol="tcp" port="80"/>
  <port protocol="tcp" port="443"/>
  <port protocol="udp" port="53"/>
  <port protocol="udp" port="123"/>
  <rule family="ipv4">
    <source address="10.0.0.0/8"/>
    <service name="ssh"/>
    <accept/>
  </rule>
  <rule family="ipv4">
    <source address="192.168.5.0/24"/>
    <service name="ssh"/>
    <accept/>
  </rule>
</zone>
