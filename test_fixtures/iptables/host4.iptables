# Generated by iptables-save v1.8.7 on Thu Sep 10 06:45:24 AM EDT 2026
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:LOGGING - [0:0]
:SSH_GUARD - [0:0]

# Established/Related
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# ICMP
-A INPUT -p icmp --icmp-type echo-request -m limit --limit 1/s -j ACCEPT
-A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
-A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT
-A INPUT -p icmp --icmp-type parameter-problem -j ACCEPT
-A INPUT -p icmp -j DROP

# SSH
-A INPUT -p tcp --dport 22 -j SSH_GUARD
-A SSH_GUARD -m state --state ESTABLISHED,RELATED -j ACCEPT
-A SSH_GUARD -s 10.0.0.0/8 -p tcp --dport 22 -m state --state NEW -j ACCEPT
-A SSH_GUARD -s 192.168.4.0/24 -p tcp --dport 22 -m state --state NEW -j ACCEPT
-A SSH_GUARD -p tcp --dport 22 -j DROP

# Web
-A INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT

# DNS
-A OUTPUT -p udp --dport 53 -j ACCEPT
-A OUTPUT -p tcp --dport 53 -j ACCEPT

# NTP
-A OUTPUT -p udp --dport 123 -j ACCEPT

# Logging
-A INPUT -j LOGGING
-A LOGGING -m limit --limit 2/min -j LOG --log-prefix "IPT-INPUT-DROP: "
-A LOGGING -j DROP

COMMIT
